# Serein DataHub Agent - Backend Environment Configuration
# Copy this to .env and fill in your values

# === LLM Provider ===
# Primary: NVIDIA NIM (build.nvidia.com) - free tier available
# Fallback: Ollama (local) - run `ollama pull qwen2.5-coder`
# Testing: stub - deterministic responses, no network needed
LLM_PROVIDER=nim
LLM_MODEL=qwen2.5-coder
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# NVIDIA NIM (get free API key at https://build.nvidia.com)
NVIDIA_API_KEY=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
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434/v1

# === DataHub Integration ===
# Primary: MCP Server (recommended for hackathon)
# Development/Demo: fixtures (works offline, guaranteed to work)
DATAHUB_PROVIDER=fixtures
DATAHUB_MCP_URL=http://localhost:8080
DATAHUB_MCP_TOKEN=
DATAHUB_GRAPHQL_URL=
DATAHUB_GRAPHQL_TOKEN=
DATAHUB_TIMEOUT_SECONDS=15
DATAHUB_FIXTURE=sales_dashboard

# === GitHub Integration ===
# Optional - uses stub provider if not configured
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_BASE_BRANCH=main
GITHUB_DRAFT_PR=true

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# === App ===
APP_NAME=Serein DataHub Agent
APP_VERSION=0.1.0